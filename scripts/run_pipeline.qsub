#!/bin/bash -l
## End-to-end rebuild of the AD loci table from this repository.
##   qsub -v AD_LOCI_INPUTS=data/build_inputs/YYYYMMDD.inputs.csv,AD_LOCI_OUT=/path/to/out_YYYYMMDD scripts/run_pipeline.qsub
## Submit from a clean checkout of the commit you want to build.
#$ -P xqtl
#$ -N adloci_e2e
#$ -l h_rt=24:00:00
#$ -pe omp 8
#$ -l mem_per_core=12G
#$ -j y
#$ -o adloci_e2e_$JOB_ID.log
#$ -V

## Repository root. SGE copies the job script to a spool directory, so this
## cannot be derived from the script's own path; it is the directory the job
## was submitted from, or AD_LOCI_REPO if set.
REPO=${AD_LOCI_REPO:-${SGE_O_WORKDIR:-$PWD}}
if [ ! -f "$REPO/scripts/build_AD_locus_table.R" ]; then
  echo "not a repository checkout: $REPO" >&2; exit 1
fi
cd "$REPO" || exit 1
export OMP_NUM_THREADS=${NSLOTS:-1}
RS=${AD_LOCI_RSCRIPT:-$HOME/.pixi/bin/Rscript}; [ -x "$RS" ] || RS=$(command -v Rscript)   # R used for every step
export AD_LOCI_ROOT=${AD_LOCI_ROOT:-/restricted/projectnb/xqtl/jaempawi/xqtl/AD_loci_xQTL}
## the three precomputed tables are read in place from the project's staging folder
export AD_LOCI_STAGING=${AD_LOCI_STAGING:-$AD_LOCI_ROOT/staging_gene_prio}
CFG_SRC=${AD_LOCI_CONFIG:-$REPO/config}
INPUTS_SRC=${AD_LOCI_INPUTS:?set AD_LOCI_INPUTS to the build input list, e.g. data/build_inputs/20261027.inputs.csv}
OUT=${AD_LOCI_OUT:-$AD_LOCI_ROOT/out_e2e_$(date +%Y%m%d_%H%M)}
export AD_LOCI_OUT=$OUT
## the code identity goes into the build record; a checkout with local changes is flagged
export AD_LOCI_COMMIT=$(git -C "$REPO" rev-parse HEAD 2>/dev/null)
export AD_LOCI_DIRTY=$([ -n "$(git -C "$REPO" status --porcelain --untracked-files=no 2>/dev/null)" ] && echo yes || echo no)

## refuse to reuse an output folder: a rerun into an old folder can mix two builds' files
if [ -e "$OUT" ] && [ -n "$(ls -A "$OUT" 2>/dev/null)" ] && [ "${AD_LOCI_ALLOW_EXISTING_OUT:-0}" != 1 ]; then
  echo "output folder already has files: $OUT (set AD_LOCI_ALLOW_EXISTING_OUT=1 to override)" >&2; exit 1
fi
## snapshot the input list and config before anything runs; the check, the build and the
## record all use these snapshots, so later edits to the originals cannot change this run
REC=$OUT/_build_record
mkdir -p "$REC/config" && cp "$CFG_SRC"/* "$REC/config/" && cp "$INPUTS_SRC" "$REC/inputs.csv" || { echo "cannot snapshot config/input list" >&2; exit 1; }
(cd "$REC/config" && md5sum * > MD5SUMS)
export AD_LOCI_CONFIG=$REC/config
INPUTS=$REC/inputs.csv
export AD_LOCI_CONFIG_SOURCE=$CFG_SRC AD_LOCI_INPUTS_SOURCE=$(realpath "$INPUTS_SRC")
echo "repo $REPO commit $AD_LOCI_COMMIT (local changes: $AD_LOCI_DIRTY)"
echo "config $CFG_SRC  staging $AD_LOCI_STAGING  inputs $INPUTS_SRC  (snapshots in $REC)"

## stop before reading anything if an input differs from the build's input list
"$RS" scripts/check_inputs.R "$INPUTS" "$AD_LOCI_ROOT" "$AD_LOCI_CONFIG" scripts/build_AD_locus_table.R 2>&1 | tee "$REC/check_inputs.txt"
[ ${PIPESTATUS[0]} -eq 0 ] || { echo "CHECK_INPUTS failed $(date)"; exit 1; }
echo "START $(date) out=$OUT"
"$RS" scripts/build_AD_locus_table.R
rc=$?
echo "BUILD_RC=$rc  $(date)"

if [ $rc -eq 0 ]; then
  ## TransMap trans-xQTL-only colocalization overlapped with the AD loci: counts as trans xQTL support (discovery), no loci, no tiers
  TMF=$(grep -o '[^,]*trans_xQTL_only_colocalization_summary_table\.bed' "$INPUTS" | head -1)
  if [ -n "$TMF" ]; then echo "---- TransMap xQTL-only overlap and xQTL support ----"; "$RS" scripts/annotate_transmap_xqtl_only.R "$AD_LOCI_ROOT/$TMF" "$OUT" 2>&1 | tee "$REC/transmap_xqtl_only.txt"; trc=${PIPESTATUS[0]}; [ $trc -ne 0 ] && rc=$trc; fi
  ## |r| between loci (review): flags loci pairs with |r| > 0.8 that the merge rule could have joined
  "$RS" scripts/locus_pair_ld.R "$OUT" 2>&1 | tee "$REC/locus_pair_ld.txt"
fi
if [ $rc -eq 0 ]; then
  echo "---- validate ----"
  "$RS" scripts/validate_outputs.R "$OUT" 2>&1 | tee "$REC/validation.txt"
  vrc=${PIPESTATUS[0]}; echo "VALIDATE_RC=$vrc"
  [ $vrc -ne 0 ] && rc=$vrc
  echo "---- build record ----"
  "$RS" scripts/build_record.R "$OUT" "$INPUTS" "${AD_LOCI_PREV:-}"
  brc=$?; echo "RECORD_RC=$brc"
  [ $brc -ne 0 ] && [ $rc -eq 0 ] && rc=$brc
fi
## a build counts as complete only if it ran, validated and has its build record
[ $rc -eq 0 ] && date -Iseconds > "$OUT/_COMPLETE"
echo "END $(date)"
exit $rc
